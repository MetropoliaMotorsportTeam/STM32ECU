CM_ BO_ 1350 "IMU board SCH16T gyro, 100 Hz";
CM_ SG_ 1350 GyroZ "Yaw rate, positive = turning left (CCW seen from above) if board Z axis points up";
CM_ BO_ 1352 "GNSS speed/course, sent once per RMC sentence";
CM_ SG_ 1352 Speed "Sent as int16 mm/s by IMU board, decode unsigned so speeds above 32.767 m/s do not wrap negative";
CM_ SG_ 1352 FixType "0 = no fix";
CM_ BO_ 1360 "Estimator state, sent after every estimator step";
CM_ SG_ 1360 Speed "Overflows above 32.767 m/s";
CM_ BO_ 1397 "Sent once at IMU board boot";
CM_ SG_ 1397 CompId "0x0000 = SPI not reaching sensor";
CM_ BO_ 1399 "Boot heartbeat, 0xB007";
VAL_ 1397 InitResult 0 "HAL_OK" 1 "HAL_ERROR" 2 "HAL_BUSY" 3 "HAL_TIMEOUT" ;
VAL_ 1397 SensorStatus 0 "Normal" 1 "Error" 2 "Saturation" 3 "Init" ;
